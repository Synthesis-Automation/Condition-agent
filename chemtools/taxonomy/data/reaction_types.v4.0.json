      },
      "products": {
        "product": ["Ar-CHCH2", "Alkenyl-Alkenyl"]
      },
      "catalysts": ["Pd"],
      "examples": ["Brc1ccccc1.C=Cc1ccccc1>>c1ccc(/C=C/c2ccccc2)cc1"]
    },
    {
      "id": "negishi",
      "name": "Negishi",
      "category": "C-C Coupling",
      "reactants": {
        "electrophile": "@sp2_electrophiles",
        "nucleophile": "@organozinc"
      },
      "products": {
        "product": ["Ar-Ar", "Ar-CHCH2", "Alkenyl-Alkenyl"]
      },
      "catalysts": ["Pd", "Ni"],
      "examples": ["Brc1ccccc1.c1ccc([Zn]Cl)cc1>>c1ccc(-c2ccccc2)cc1"]
    },
    {
      "id": "stille",
      "name": "Stille",
      "category": "C-C Coupling",
      "reactants": {
        "electrophile": "@sp2_electrophiles",
        "nucleophile": "@organotin"
      },
      "products": {
        "product": ["Ar-Ar", "Ar-CHCH2", "Alkenyl-Alkenyl"]
      },
      "catalysts": ["Pd"],
      "examples": ["Brc1ccccc1.c1ccc(Sn(C)C)cc1>>c1ccc(-c2ccccc2)cc1"]
    },
    {
      "id": "kumada",
      "name": "Kumada",
      "category": "C-C Coupling",
      "reactants": {
        "electrophile": "@sp2_electrophiles",
        "nucleophile": "@organomagnesium"
      },
      "products": {
        "product": ["Ar-Ar", "Ar-CHCH2", "Alkenyl-Alkenyl"]
      },
      "catalysts": ["Ni", "Pd"],
      "examples": ["Brc1ccccc1.c1ccc(MgBr)cc1>>c1ccc(-c2ccccc2)cc1"]
    },
    {
      "id": "hiyama",
      "name": "Hiyama",
      "category": "C-C Coupling",
      "reactants": {
        "electrophile": "@sp2_electrophiles",
