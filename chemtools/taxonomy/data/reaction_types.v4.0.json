      },
      "products": {
        "product": ["Ar-Alkynyl"]
      },
      "catalysts": ["Pd", "Cu"],
      "examples": ["Brc1ccccc1.C#Cc1ccccc1>>c1ccc(C#Cc2ccccc2)cc1"]
    },
    {
      "id": "heck",
      "name": "Heck",
      "category": "C-C Coupling",
      "reactants": {
