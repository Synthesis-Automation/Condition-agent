  "repairs": [
    {
      "id": "RP-LOW-CONVERSION",
      "if": {
        "outcome": "low_conversion"
      },
      "then": {
        "sequence": [
          "raise_temperature:+10 °C (if stable)",
          "increase_equivalents: amine +0.3, reagent +0.2",
          "switch_solvent: DMF ↔ MeCN ↔ DCM",
          "switch_reagent: EDC/Oxyma → HATU → T3P",
          "preactivate: CDI or IBCF or acyl fluoride",
          "add_catalyst: DMAP 5–10 mol% for anhydrides/acyl chlorides"
        ]
      }
    },
    {
      "id": "RP-RACEMIZATION",
      "if": {
        "outcome in": [
          "low_ee",
          "dr_erosion"
        ]
      },
      "then": {
        "sequence": [
          "lower_temperature_to: 0–5 °C",
          "shorten_time_to_h: ≤2",
          "switch_route: IBCF (cold) or acyl fluoride (TFFH/BTFFH)",
          "replace_base: DIPEA → NMM/pyridine",
          "ensure_additive: Oxyma ≥1.2 eq"
        ]
      }
    },
    {
      "id": "RP-INSOLUBLE/CLUMP",
      "if": {
        "outcome in": [
          "heterogeneous_mixture",
          "filtration_clogging"
        ]
      },
      "then": {
        "sequence": [
          "switch_reagent: DCC → DIC/EDC/T3P",
          "add_cosolvent: 10–30% DMF/NMP",
          "heat_to: 40–60 °C (if stable)"
        ]
      }
    },
    {
      "id": "RP-UREA-RESIDUES",
      "if": {
        "outcome": "urea/EDU carryover"
      },
      "then": {
        "sequence": [
          "acidic_wash: 0.5 M HCl",
          "carbon_treatment_or_silica_plug",
          "solvent_swap: DCM ↔ EtOAc before washes"
        ]
      }
    }
  ]
