{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://condition-agent.local/schemas/automation_handoff.v1.schema.json",
  "title": "Condition automation planning handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "handoff_id", "definition_id", "query_reaction_smiles", "execution_ready", "execution_status", "robot_target", "required_before_execution", "warnings", "experiments"],
  "properties": {
    "artifact_type": {"const": "condition_automation_handoff"},
    "schema_version": {"const": "1.0"},
    "handoff_id": {"type": "string", "pattern": "^CAH1:[0-9a-f]{64}$"},
    "definition_id": {"const": "combined_recommendation.v1"},
    "query_reaction_smiles": {"type": "string", "minLength": 1},
    "execution_ready": {"const": false},
    "execution_status": {"const": "requires_robot_adapter_and_review"},
    "robot_target": {"type": "null"},
    "required_before_execution": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "experiments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["option_id", "protocol", "resolved_recipe", "evidence_kind", "evidence", "cautions"],
        "properties": {
          "option_id": {"type": "string", "pattern": "^CCO1:[0-9a-f]{64}$"},
          "protocol": {"$ref": "https://condition-agent.local/schemas/synthesis_protocol.v1.schema.json"},
          "resolved_recipe": {"type": "object"},
          "evidence_kind": {"enum": ["verified_signature", "structure_review", "weak_label"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "cautions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
