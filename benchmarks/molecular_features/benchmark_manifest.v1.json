    "secondary_dimethylamine": {"XH|N|H1|Alkyl,Alkyl": [[1]]},
    "primary_tert_butylamine": {"XH|N|H2|Alkyl": [[4]]},
    "primary_aniline": {"XH|N|H2|Ar": [[0]]},
    "benzyl_chloride": {"LG|Alkyl|Cl": [[0, 1]]},
    "aryl_bromide_with_nitrile": {
      "LG|Ar|Br": [[0, 1]],
      "PI|Nitrile": [[5, 6]]
    },
    "heteroaryl_chloride": {"LG|HeteroAr|Cl": [[0, 1]]},
    "aryl_boronic_acid": {"TM|Ar|B(OH)2": [[0, 1, 2, 3]]},
    "acetyl_chloride": {"EC|Acyl|Alkyl|Cl|activated": [[0, 1, 2, 3]]},
    "acetic_acid": {
      "EC|Acyl|Alkyl|OH|latent": [[0, 1, 2, 3]],
      "XH|O|H1|C(O)R": [[3]]
    },
    "acetaldehyde": {"EC|Carbonyl|aldehyde|Alkyl|addition": [[0, 1, 2]]},
    "acetone": {"EC|Carbonyl|ketone|Alkyl,Alkyl|addition": [[0, 1, 2, 3]]},
    "phenol": {"XH|O|H1|Ar": [[0]]},
    "ethyl_thiol": {"XH|S|H1|Alkyl": [[2]]},
    "secondary_sulfonamide": {"XH|N|H1|SO2R,Alkyl": [[4]]},
    "terminal_alkene": {"PI|Alkene": [[1, 2]]},
    "terminal_alkyne": {"PI|Alkyne": [[1, 2]], "XH|Csp|H1|Alkynyl": [[2]]},
    "aminopyridine": {"XH|N|H2|HeteroAr": [[0]]},
    "hindered_electron_poor_aryl_bromide": {
      "LG|Ar|Br": [[0, 1]],
      "PI|Nitrile": [[8, 9]]
    }
  },
  "cases": [
    {
      "case_id": "primary_methylamine",
      "smiles": "CN",
      "equivalent_smiles": ["NC"],
      "expected_valid": true,
      "expected_group_counts": {"primary_amine": 1},
      "expected_site_counts": {"XH|N|H2|Alkyl": 1},
      "environment_expectations": [
        {
          "site_signature": "XH|N|H2|Alkyl",
          "steric_equals": {"center_substitution_class": "primary"},
          "attached_group_classes": ["methyl"],
          "electronic_class": "neutral",
          "nearby_group_ids_present": ["primary_amine"]
        }
      ]
    },
    {
      "case_id": "secondary_dimethylamine",
      "smiles": "CNC",
      "equivalent_smiles": ["C[NH]C"],
      "expected_valid": true,
      "expected_group_counts": {"secondary_amine": 1},
      "expected_site_counts": {"XH|N|H1|Alkyl,Alkyl": 1},
      "environment_expectations": [
        {
          "site_signature": "XH|N|H1|Alkyl,Alkyl",
