      },
      "products": {
        "product": ["Ar-Ar", "Ar-CHCH2", "Alkenyl-Alkenyl"]
      },
      "catalysts": ["Pd"],
      "examples": ["Brc1ccccc1.c1ccc(Si(OC)3)cc1>>c1ccc(-c2ccccc2)cc1"]
    },
    {
      "id": "snar_cn",
      "name": "SNAr C-N",
      "category": "C-N Coupling",
      "reactants": {
        "electrophile": "@aromatic_halides",
        "activator": "@aromatic_activators",
        "nucleophile": "@amines_nh"
      },
      "products": {
        "product": "@aryl_amines"
      },
      "examples": ["Fc1ccc([N+](=O)[O-])cc1.NC>>Nc1ccc([N+](=O)[O-])cc1"]
    },
    {
      "id": "amide_coupling",
      "name": "Amide Coupling",
      "category": "Amide Formation",
      "reactants": {
        "acid": "@carboxylic_acids",
        "nucleophile": "@amines_nh"
      },
      "products": {
        "product": "@amides"
      },
      "examples": ["O=C(O)c1ccccc1.NCc1ccccc1>>O=C(NCc1ccccc1)c1ccccc1"]
    },
    {
      "id": "esterification",
      "name": "Esterification",
      "category": "Ester Formation",
      "reactants": {
        "acid": "@carboxylic_acids",
        "nucleophile": "@alcohols_oh"
      },
      "products": {
        "product": "@esters"
      },
      "examples": ["CC(=O)O.CCO>>CC(=O)OCC"]
    },
    {
      "id": "acylation_amide",
      "name": "Acylation (Amide)",
      "category": "Amide Formation",
      "reactants": {
        "electrophile": "@acyl_halides",
        "nucleophile": "@amines_nh"
      },
      "products": {
        "product": "@amides"
      },
      "examples": ["CC(=O)Cl.Nc1ccccc1>>CC(=O)Nc1ccccc1"]
    },
    {
      "id": "reductive_amination",
      "name": "Reductive Amination",
      "category": "C-N Coupling",
      "reactants": {
        "electrophile": "@carbonyls",
        "nucleophile": "@amines_nh"
      },
      "products": {
        "product": ["Any-NHR", "Any-NR2", "Ar-NHR", "Ar-NR2"]
      },
      "examples": ["c1ccccc1C=O.NCC>>c1ccccc1CNCC"]
    },
    {
      "id": "ring_closing_metathesis",
      "name": "Ring-Closing Metathesis",
      "category": "C-C Coupling",
      "reactants": {
        "alkene": "@terminal_alkenes"
      },
      "constraints": {
        "min_hits": 2,
        "min_reactants": 1
      },
      "examples": ["C=CCCC=C>>C1=CCCC1"]
    },
    {
      "id": "hydrogenation",
      "name": "Hydrogenation",
      "category": "Reduction",
      "reactants": {
        "substrate": "@hydrogenation_substrates",
        "reagent": ["H2"]
      },
      "examples": ["C=C.[H][H]>>CC"]
    },
    {
      "id": "click_cuaac",
      "name": "Click (CuAAC)",
      "category": "Cycloaddition",
      "reactants": {
        "alkyne": "@terminal_alkynes",
        "azide": "@azides"
      },
      "catalysts": ["Cu"],
      "examples": ["C#Cc1ccccc1.CN=[N+]=[N-]>>Cn1cc(-c2ccccc2)nn1"]
    },
    {
      "id": "acylation_ester",
      "name": "Acylation (Ester)",
      "category": "Ester Formation",
      "reactants": {
        "electrophile": "@acyl_halides",
        "nucleophile": "@alcohols_oh"
      },
      "products": {
        "product": "@esters"
      },
      "examples": ["CC(=O)Cl.CCO>>CC(=O)OCC"]
    },
    {
      "id": "oxidation_alcohol",
      "name": "Alcohol Oxidation",
      "category": "Oxidation",
      "reactants": {
        "substrate": "@alcohols_oh"
      },
      "products": {
        "product": ["@carbonyls", "@carboxylic_acids"]
      },
      "examples": ["c1ccccc1CO>>c1ccccc1C=O"]
    },
    {
      "id": "reduction_nitro",
      "name": "Nitro Reduction",
      "category": "Reduction",
      "reactants": {
        "substrate": "@nitro_compounds"
      },
      "products": {
        "product": ["Ar-NH2", "Any-NH2"]
      },
      "examples": ["c1ccccc1[N+](=O)[O-]>>c1ccccc1N"]
    },
    {
      "id": "halogenation_aromatic",
      "name": "Aromatic Halogenation",
      "category": "Halogenation",
      "reactants": {
        "substrate": ["Ar-H"]
      },
      "products": {
        "product": "@aromatic_halides"
      },
      "examples": ["c1ccccc1.ClCl>>c1ccccc1Cl"]
    },
    {
      "id": "epoxidation",
      "name": "Epoxidation",
      "category": "Oxidation",
      "reactants": {
        "substrate": ["@terminal_alkenes", "Any-Alkene"]
      },
      "products": {
        "product": ["Epoxide"]
      },
      "examples": ["C=C.OO>>C1OC1"]
    },
    {
      "id": "claisen_condensation",
      "name": "Claisen Condensation",
      "category": "Carbonyl Reactions",
      "reactants": {
        "ester": "@esters"
      },
      "constraints": {
        "min_hits": 2
      },
      "examples": ["CCOC(=O)C.CCOC(=O)C>>CC(=O)CC(=O)OCC"]
    }
  ]
}
