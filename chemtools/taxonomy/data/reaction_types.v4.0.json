{
  "version": "4.0",
  "notes": "Simplified reaction taxonomy using direct motif mapping and global motif groups from compound_logic.json.",
  "reaction_types": [
    {
      "id": "suzuki_miyaura",
      "name": "Suzuki-Miyaura",
      "category": "C-C Coupling",
      "reactants": {
        "electrophile": "@sp2_electrophiles",
        "nucleophile": "@organoboron"
      },
      "products": {
        "product": ["Ar-Ar", "Ar-CHCH2", "Alkenyl-Alkenyl"]
      },
      "catalysts": ["Pd"],
      "examples": ["Brc1ccccc1.OB(O)c1ccccc1>>c1ccc(-c2ccccc2)cc1"]
    },
    {
      "id": "buchwald_hartwig",
      "name": "Buchwald-Hartwig",
      "category": "C-N Coupling",
      "reactants": {
        "electrophile": "@sp2_electrophiles",
        "nucleophile": "@amines_nh"
      },
      "products": {
        "product": "@aryl_amines"
      },
      "catalysts": ["Pd"],
      "examples": ["Brc1ccccc1.Nc1ccccc1>>c1ccccc1Nc1ccccc1"]
    },
    {
      "id": "chan_lam_cn",
      "name": "Chan-Lam C-N",
      "category": "C-N Coupling",
      "reactants": {
        "electrophile": "@organoboron",
        "nucleophile": "@amines_nh"
      },
      "products": {
        "product": "@aryl_amines"
      },
      "catalysts": ["Cu"],
      "examples": ["c1ccccc1B(O)O.Nc1ccccc1>>c1ccccc1Nc1ccccc1"]
    },
    {
      "id": "ullmann_ether",
      "name": "Ullmann Ether Synthesis",
      "category": "C-O Coupling",
      "reactants": {
        "electrophile": "@sp2_electrophiles",
        "nucleophile": "@alcohols_oh"
      },
      "products": {
        "product": "@aryl_ethers"
      },
      "catalysts": ["Cu", "Pd"],
      "examples": ["Brc1ccccc1.Oc1ccccc1>>c1ccccc1Oc1ccccc1"]
    },
    {
      "id": "sonogashira",
      "name": "Sonogashira",
      "category": "C-C Coupling",
      "reactants": {
        "electrophile": "@sp2_electrophiles",
