$DTYPE RXN:VAR(1):REFERENCE(1):AUTHOR
$DATUM Grohmann, Christoph; Wang, Honggen; Glorius, Frank
$DTYPE RXN:VAR(1):REFERENCE(1):CITATION
$DATUM Organic Letters (2012), 14(2), 656-659

