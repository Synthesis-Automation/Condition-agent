        "AMIDE-HATU-HINDERED"
      ],
      "comment": "Higher racemization risk; default to cold EDC/Oxyma, acyl fluoride, or mixed anhydride."
    },
    {
      "feature": "need_low_halogenated_solvents=true",
      "effect": "boost",
      "targets": [
        "AMIDE-T3P-SCALE",
        "AMIDE-EDC-OXYMA-GENERAL",
        "AMIDE-COMU-OXYMA-GREEN"
      ],
      "comment": "EtOAc/MeCN/2-MeTHF alternatives available."
    },
    {
      "feature": "alcohol_present=true",
      "effect": "boost",
      "targets": [
        "AMIDE-ACYL-FLUORIDE-TFFH",
        "AMIDE-ALCOHOL-PRESENT-CHEMOSELECTIVE"
      ],
      "comment": "Chemoselectivity improved with acyl fluorides."
    }
  ],
  "repairs": [
    {
      "id": "AMIDE-REPAIR-LOW-CONVERSION",
      "if": {
        "outcome": "low_conversion"
      },
      "then": {
        "action": "sequential_retry",
        "steps": [
          "raise_temp_by: 10",
          "increase_equivalents: amine +0.3, reagent +0.2",
          "switch_solvent: DMF↔MeCN↔DCM",
          "switch_reagent: EDC/Oxyma → HATU → T3P",
          "preactivate: CDI or acid chloride or acyl fluoride",
          "add_catalyst: DMAP (5–10 mol%) for anhydrides/acyl chlorides"
        ]
      }
    },
    {
      "id": "AMIDE-REPAIR-RACEMIZATION",
      "if": {
        "outcome": "low_ee or dr_erosion"
      },
      "then": {
        "action": "process_change",
        "steps": [
          "lower_temperature_to: 0–5 °C",
          "shorten_time_to_h: ≤2",
          "switch_route: mixed anhydride (IBCF/NMM, −20 to 0 °C) or acyl fluoride (TFFH)",
          "replace_base: DIPEA → NMM/pyridine",
          "use_additive: Oxyma (≥1.2 eq)"
        ]
      }
    },
    {
      "id": "AMIDE-REPAIR-INSOLUBLE-SOLIDS",
      "if": {
        "outcome": "heterogeneous_mixture or filtration_clogging"
      },
      "then": {
        "action": "operational_change",
        "steps": [
          "switch_reagent: DCC → DIC/EDC/T3P",
          "add_cosolvent: DMF or NMP (10–30%)",
          "heat_to: 40–60 °C (if substrates stable)"
        ]
      }
    },
    {
      "id": "AMIDE-REPAIR-UREA-CONTAMINATION",
      "if": {
        "outcome": "high_EDU_or_DCU_residuals"
      },
      "then": {
        "action": "workup_change",
        "steps": [
          "acid_wash: 0.5 M HCl (removes EDU/urea)",
          "silica_plug_or_carbon_treatment: if colored byproducts persist",
          "solvent_swap: DCM↔EtOAc before washes"
        ]
      }
    }
  ]
}
