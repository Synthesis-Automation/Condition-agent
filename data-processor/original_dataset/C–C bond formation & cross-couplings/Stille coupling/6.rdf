$DATUM Liu, Chao-Min; Guo, Yin-Long; Xu, Qi-Hai; Liamg, Yong-Min; Ma, Yong-Xiang
$DTYPE RXN:VAR(1):REFERENCE(1):CITATION
$DATUM Synthetic Communications (2000), 30(24), 4405-4410

