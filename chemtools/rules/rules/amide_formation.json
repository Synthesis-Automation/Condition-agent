{
  "reaction": "Amide bond formation (carboxylic acid + amine)",
  "version": "2025-09-30-full",
  "schema_version": "1.1",
  "defaults": {
    "concentration_M": 0.2,
    "temperature_C": 25,
    "time_h": 16,
    "stoichiometry": {
      "acid_eq": 1.0,
      "amine_eq": 1.1,
      "coupling_reagent_eq": 1.2,
      "additive_eq": 1.2,
      "base_eq": 2.0
    },
    "solvent_priority": [
      "DMF",
      "MeCN",
      "DCM",
      "THF",
      "EtOAc",
      "2-MeTHF"
    ],
    "base_priority": [
      "DIPEA",
      "NMM",
      "iPr2NEt",
      "pyridine"
    ],
    "agitation": {
      "rpm_min": 500,
      "note": "Ensure homogeneity; add DMF/NMP co-solvent if solids persist."
    },
    "notes": [
      "Prefer Oxyma/ethyl cyano(hydroxyimino)acetate or related additives over HOBt/HOAt for safety; avoid drying HOBt/HOAt.",
      "For scale-up, T3P (50% in EtOAc or MeCN) and EDC/Oxyma simplify workup compared to uronium/phosphonium salts.",
      "Control temperature for alpha-chiral acids to limit racemization; pre-cool and add amine last.",
      "Pre-activation (e.g., CDI or as acyl fluoride/chloride) can rescue sluggish anilines but may reduce chemoselectivity.",
      "Exclude water for acid chloride or CDI routes; for EDC-type reagents, moderate moisture tolerance but slower rates."
    ]
  },
  "playbooks": [
    {
      "id": "AMIDE-EDC-OXYMA-GENERAL",
      "name": "EDC·HCl + Oxyma (general, balanced)",
      "status": "recommended",
      "when": {
        "acid": {
          "class": "aliphatic or benzoic acid"
        },
        "amine": {
          "class": "primary or secondary, not highly hindered"
        },
        "constraints": {
          "avoid_explosive_additives": true
        }
      },
      "recipe": {
        "reagent": "EDC·HCl",
        "additive": [
          "Oxyma"
        ],
        "base": [
          "DIPEA",
          "NMM"
        ],
        "solvent": [
          "DMF",
          "MeCN",
          "DCM"
        ],
        "temperature_C": [
          0,
          25
        ],
        "time_h": [
          2,
          18
        ],
        "stoichiometry": {
          "EDC_eq": 1.2,
          "Oxyma_eq": 1.2,
          "amine_eq": 1.1,
          "base_eq": 2.0
        },
        "workup": [
          "Dilute with DCM or EtOAc.",
          "Wash with saturated NaHCO3 and brine.",
          "Acidic wash (0.5 M HCl) removes EDU/urea residues if needed."
        ]
      }
    },
