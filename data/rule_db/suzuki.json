{
  "reaction_type": "Suzuki-Miyaura",
  "version": "2025-11-02",
  "evaluation": "Use this file ONLY if 'applies_if' tokens are present. Then try base_rules (top→down). If none match, use default_rule. After picking a rule, scan all modifiers and apply those that match (tokens OR plain-text heuristics).",
  "applies_if": {
    "all": ["sp2_halide_present", "sp2_boron_present"]
  },
  "default_rule": {
    "id": "DEF_sp2_general",
    "description": "General starter for sp2–sp2 Suzuki (avoid Pd(PPh3)4 as first choice).",
    "conditions": {
      "pd_source": "PdCl2(dtbpf)",
      "ligand": "dtbpf or dppf",
      "pd_loading_molpct": "1–2",
      "base": "K3PO4 (aq, 3.25 M)",
      "solvent": "dioxane/H2O ~10:1",
      "temperature_C": "80–100",
      "time_h": "1–12",
      "atmosphere": "N2 or Ar"
    }
  },
  "base_rules": [
    {
      "id": "BR_arCl_unhindered_or_EWG",
      "description": "Aryl chloride that is unhindered OR has EWG near ipso.",
      "reactant_features": {
        "and": ["sp2_chloride_present", "sp2_boron_present"]
      },
      "conditions": {
        "pd_source": "Pd(dba)2",
        "ligand": "XPhos",
        "base": "K3PO4 (aq)",
        "solvent": "dioxane/H2O ~10:1",
        "temperature_C": "100–120"
      }
    },
    {
      "id": "BR_hindered_or_heteroaryl",
      "description": "Sterically hindered site OR heteroaryl present.",
      "reactant_features": {
        "any": ["ortho_substitution_present"]
      },
      "conditions": {
        "pd_source": "Pd(dba)2",
        "ligand": "SPhos",
        "base": "K3PO4 (aq)",
        "solvent": "THF/H2O ~4:1",
        "temperature_C": "80–110"
      }
    }
  ],
  "modifiers": [
    {
      "id": "MOD_polarity_high",
      "when": ["polarity_low"],
      "suggest": "Set solvent to THF/H2O (3–5:1)."
    },
    {
      "id": "MOD_hydrodehalogenation_TBAB",
      "when": ["symptom:if hydrodehalogenation is observed"],
      "suggest": "Add TBAB 0.5–1.0 equiv."
    }
  ]
}
