{
  "version": "1.0",
  "depends_on": {
    "organic_groups": "organic_groups.v1.json",
    "organic_compounds": "organic_compounds.v1.json",
    "smarts_templates": "smarts_templates.v1.json"
  },
  "notes": [
    "Chemist-facing reaction-type definitions based on motif/compound detection (no calculable_features required).",
    "Use roles as named motif packs; each reaction type is defined by required roles.",
    "Confirmation can be reactants_only (fast typing) or reactants_and_products (if product SMILES is available).",
    "This file intentionally avoids atom-mapped reaction SMARTS; it is meant for robust, interpretable type classification."
  ],
  "roles": {
    "sp2_halide": {
      "description": "sp2 C–X electrophiles (aryl/heteroaryl/vinyl halides; X = F/Cl/Br/I).",
      "motifs_any_of": [
        "Ar-Br",
        "Ar-Cl",
        "Ar-F",
        "Ar-I",
        "Arom-Br",
        "Arom-Cl",
        "Arom-F",
        "Arom-I",
        "Vinyl-Br",
        "Vinyl-Cl",
        "Vinyl-F",
        "Vinyl-I"
      ]
    },
    "sp2_sulfonate": {
      "description": "sp2 C–O–SO2R electrophiles (aryl/heteroaryl/vinyl sulfonates: OTf/OTs/OMs).",
      "motifs_any_of": [
        "Ar-OMs",
        "Ar-OTf",
        "Ar-OTs",
        "Arom-OMs",
        "Arom-OTf",
        "Arom-OTs",
        "Vinyl-OMs",
        "Vinyl-OTf",
        "Vinyl-OTs"
      ]
    },
    "sp2_electrophile": {
      "description": "Common sp2 electrophiles for cross-coupling (sp2 halides + sulfonates).",
      "motifs_any_of": [
        "Ar-Br",
        "Ar-Cl",
        "Ar-F",
        "Ar-I",
        "Ar-OMs",
        "Ar-OTf",
        "Ar-OTs",
        "Arom-Br",
        "Arom-Cl",
        "Arom-F",
        "Arom-I",
        "Arom-OMs",
        "Arom-OTf",
        "Arom-OTs",
        "Vinyl-Br",
        "Vinyl-Cl",
        "Vinyl-F",
        "Vinyl-I",
        "Vinyl-OMs",
        "Vinyl-OTf",
        "Vinyl-OTs"
      ]
    },
    "organoboron_partner": {
      "description": "Organoboron partners (boronic acid / Bpin) for Suzuki-type coupling.",
      "motifs_any_of": [
        "Ar-B(OH)2",
        "Ar-Bpin",
        "Arom-B(OH)2",
        "Arom-Bpin",
        "Vinyl-B(OH)2",
        "Vinyl-Bpin"
      ]
    },
    "amine_nh_nucleophile": {
      "description": "N–H amine nucleophiles (NH2 or NHR).",
      "motifs_any_of": [
        "Allyl-NH2",
        "Allyl-NHR",
        "Any-NH2",
        "Any-NH2",
        "Ar-NH2",
        "Ar-NHR",
        "Arom-NH2",
        "Arom-NHR",
        "Bn-NH2",
        "Bn-NHR",
        "Vinyl-NH2"
      ]
    },
    "amine_product": {
      "description": "Amine motifs typically observed in products (NHR or NR2 on aryl/heteroaryl/benzylic/allylic contexts).",
      "motifs_any_of": [
        "Allyl-NHR",
        "Allyl-NR2",
        "Ar-NHR",
        "Ar-NR2",
        "Arom-NHR",
        "Arom-NR2",
        "Bn-NHR",
        "Bn-NR2"
      ]
    },
    "alcohol_nucleophile": {
      "description": "Alcohol/phenol nucleophiles (–OH).",
      "motifs_any_of": [
        "Allyl-OH",
        "Any-OH",
        "Ar-OH",
        "Arom-OH",
        "Bn-OH",
        "Vinyl-OH"
      ]
    },
    "thiol_nucleophile": {
      "description": "Thiol nucleophiles (–SH).",
      "motifs_any_of": [
        "Any-SH",
        "Ar-SH",
        "Arom-SH"
      ]
    },
    "acyl_halide": {
      "description": "Acyl halides (acid chlorides / acid bromides).",
      "motifs_any_of": [
        "Acyl-Br",
        "Acyl-Cl",
        "Any-COCl",
        "Ar-COCl",
        "Arom-COCl"
      ]
    },
    "carboxylic_acid": {
      "description": "Carboxylic acids (–CO2H).",
      "motifs_any_of": [
        "Any-CO2H",
        "Ar-CO2H",
        "Arom-CO2H",
        "Vinyl-CO2H"
      ]
    },
    "ester": {
      "description": "Ester motifs (–CO2R).",
      "motifs_any_of": [
        "Any-CO2R",
        "Ar-CO2R",
        "Arom-CO2R",
        "Vinyl-CO2R"
      ]
    },
    "amide": {
      "description": "Amide motifs (–CONHR).",
      "motifs_any_of": [
        "Any-CONHR",
        "Ar-CONHR",
        "Arom-CONHR"
      ]
    },
    "aromatic_halide_for_snar": {
      "description": "Aromatic halides commonly used in SNAr (aryl/heteroaryl F/Cl/Br).",
      "motifs_any_of": [
        "Ar-Br",
        "Ar-Cl",
        "Ar-F",
        "Arom-Br",
        "Arom-Cl",
        "Arom-F"
      ]
    },
    "aromatic_ewg": {
      "description": "Common aromatic electron-withdrawing groups that activate SNAr (NO2/CN/CHO).",
      "motifs_any_of": [
        "Ar-CHO",
        "Ar-CN",
        "Ar-NO2",
        "Arom-CHO",
        "Arom-CN",
        "Arom-NO2"
      ]
    },
    "benzylic_halide": {
      "description": "Benzylic halides (Bn–Cl/Br/I) for SN2 alkylation.",
      "motifs_any_of": [
        "Bn-Br",
        "Bn-Cl",
        "Bn-I"
      ]
    },
    "allylic_halide": {
      "description": "Allylic halides (Allyl–Cl/Br/I) for SN2/SN2' alkylation.",
      "motifs_any_of": [
        "Allyl-Br",
        "Allyl-Cl",
        "Allyl-I"
      ]
    }
  },
  "reaction_types": [
    {
      "id": "suzuki_miyaura",
      "name": "Suzuki–Miyaura coupling",
      "family": "cross_coupling",
      "requires_all_roles": [
        "sp2_electrophile",
        "organoboron_partner"
      ],
      "confirm": {
        "mode": "reactants_only",
        "optional_product_checks": [
          {
            "product_should_not_have_roles": [
              "sp2_electrophile",
              "organoboron_partner"
            ],
            "note": "Heuristic only (product may still contain other halides/boron elsewhere)."
          }
        ]
      },
      "notes": "Classify by reactant motifs: an sp2 electrophile (aryl/heteroaryl/vinyl halide or sulfonate) + an organoboron partner."
    },
    {
      "id": "c_n_cross_coupling",
      "name": "C–N cross-coupling (aryl/heteroaryl electrophile + amine)",
      "family": "cross_coupling",
      "requires_all_roles": [
        "sp2_electrophile",
        "amine_nh_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_only",
        "optional_product_checks": [
          {
            "product_should_have_any_of_motifs": [
              "Ar-NHR",
              "Ar-NR2",
              "Arom-NHR",
              "Arom-NR2"
            ],
            "note": "If product SMILES is available, presence of aryl/heteroaryl amine motifs supports this classification."
          }
        ]
      },
      "notes": "Includes Buchwald–Hartwig / Ullmann-style aryl amination at the reaction-type level (catalyst not inferred here)."
    },
    {
      "id": "c_o_cross_coupling",
      "name": "C–O coupling (aryl/heteroaryl electrophile + alcohol/phenol)",
      "family": "cross_coupling",
      "requires_all_roles": [
        "sp2_electrophile",
        "alcohol_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_only"
      },
      "notes": "Product ether motifs are not yet explicitly represented in organic_compounds.v1.json, so confirmation is reactants-only."
    },
    {
      "id": "c_s_cross_coupling",
      "name": "C–S coupling (aryl/heteroaryl electrophile + thiol)",
      "family": "cross_coupling",
      "requires_all_roles": [
        "sp2_electrophile",
        "thiol_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_only"
      },
      "notes": "Product thioether motifs are not yet explicitly represented in organic_compounds.v1.json, so confirmation is reactants-only."
    },
    {
      "id": "amide_formation_acyl_halide",
      "name": "Amide formation (acyl halide + amine)",
      "family": "acyl_substitution",
      "requires_all_roles": [
        "acyl_halide",
        "amine_nh_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_and_products",
        "product_should_have_roles": [
          "amide"
        ],
        "product_should_not_have_roles": [
          "acyl_halide"
        ]
      },
      "notes": "Covers typical acid chloride/bromide amidation to give –CONHR."
    },
    {
      "id": "ester_formation_acyl_halide",
      "name": "Ester formation (acyl halide + alcohol/phenol)",
      "family": "acyl_substitution",
      "requires_all_roles": [
        "acyl_halide",
        "alcohol_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_and_products",
        "product_should_have_roles": [
          "ester"
        ],
        "product_should_not_have_roles": [
          "acyl_halide"
        ]
      },
      "notes": "Covers typical acid chloride/bromide esterification to give –CO2R."
    },
    {
      "id": "carboxylic_acid_to_acyl_chloride",
      "name": "Carboxylic acid activation to acyl chloride",
      "family": "functional_group_interconversion",
      "requires_all_roles": [
        "carboxylic_acid"
      ],
      "confirm": {
        "mode": "reactants_and_products",
        "product_should_have_roles": [
          "acyl_halide"
        ]
      },
      "notes": "Covers SOCl2/oxalyl chloride-type conversions at the motif level (reagents not inferred here)."
    },
    {
      "id": "acyl_chloride_hydrolysis",
      "name": "Acyl chloride hydrolysis to carboxylic acid",
      "family": "functional_group_interconversion",
      "requires_all_roles": [
        "acyl_halide"
      ],
      "confirm": {
        "mode": "reactants_and_products",
        "product_should_have_roles": [
          "carboxylic_acid"
        ],
        "product_should_not_have_roles": [
          "acyl_halide"
        ]
      },
      "notes": "Workup / hydrolysis motif transformation."
    },
    {
      "id": "fischer_esterification",
      "name": "Esterification (carboxylic acid + alcohol → ester)",
      "family": "condensation",
      "requires_all_roles": [
        "carboxylic_acid",
        "alcohol_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_and_products",
        "product_should_have_roles": [
          "ester"
        ]
      },
      "notes": "Includes Fischer esterification and related acid-mediated ester formation; water/byproducts not modeled."
    },
    {
      "id": "snar_amination",
      "name": "SNAr amination (activated aromatic halide + amine)",
      "family": "nucleophilic_aromatic_substitution",
      "requires_all_roles": [
        "aromatic_halide_for_snar",
        "aromatic_ewg",
        "amine_nh_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_and_products",
        "product_should_have_any_of_motifs": [
          "Ar-NHR",
          "Ar-NR2",
          "Arom-NHR",
          "Arom-NR2"
        ],
        "product_should_not_have_roles": [
          "aromatic_halide_for_snar"
        ]
      },
      "notes": "Heuristic activation check: requires aromatic halide + common EWG motifs in the same reactant set (not necessarily same ring)."
    },
    {
      "id": "n_alkylation_benzylic",
      "name": "N-alkylation (benzylic halide + amine)",
      "family": "nucleophilic_substitution",
      "requires_all_roles": [
        "benzylic_halide",
        "amine_nh_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_and_products",
        "product_should_have_any_of_motifs": [
          "Bn-NH2",
          "Bn-NHR",
          "Bn-NR2"
        ],
        "product_should_not_have_roles": [
          "benzylic_halide"
        ]
      },
      "notes": "Covers benzylation of N–H amines at the motif level."
    },
    {
      "id": "n_alkylation_allylic",
      "name": "N-alkylation (allylic halide + amine)",
      "family": "nucleophilic_substitution",
      "requires_all_roles": [
        "allylic_halide",
        "amine_nh_nucleophile"
      ],
      "confirm": {
        "mode": "reactants_and_products",
        "product_should_have_any_of_motifs": [
          "Allyl-NH2",
          "Allyl-NHR",
          "Allyl-NR2"
        ],
        "product_should_not_have_roles": [
          "allylic_halide"
        ]
      },
      "notes": "Covers allylation of N–H amines at the motif level (SN2/SN2' not distinguished)."
    }
  ]
}