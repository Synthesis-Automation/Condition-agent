  "guards": [
    {
      "id": "AMIDE-GUARD-EXPLOSIVE-ADDITIVES",
      "if": {
        "additive in": [
          "HOBt",
          "HOAt"
        ]
      },
      "action": "warn_or_substitute",
      "rationale": "Dry HOBt/HOAt can be explosive; prefer Oxyma/ethyl cyanohydroxyiminoacetate."
    },
    {
      "id": "AMIDE-GUARD-RACEMIZATION",
      "if": {
        "acid": {
          "class": "alpha-chiral"
        }
      },
      "action": "enforce",
      "params": {
        "max_temperature_C": 25,
        "max_time_h": 6,
        "prefer_playbooks": [
          "AMIDE-EDC-OXYMA-GENERAL",
          "AMIDE-MIXED-ANHYDRIDE-IBCF",
          "AMIDE-ACYL-FLUORIDE-TFFH",
          "AMIDE-T3P-SCALE"
        ]
      },
      "rationale": "Minimize oxazolone/ketene formation and base-promoted epimerization."
    },
    {
      "id": "AMIDE-GUARD-DCU-CLOG",
      "if": {
        "reagent": "DCC"
      },
      "action": "warn",
      "rationale": "Insoluble DCU may clog equipment/filtration; consider DIC (soluble) or EDC/T3P."
    },
    {
      "id": "AMIDE-GUARD-ACID-CHLORIDE-HAZARD",
      "if": {
        "activator": "oxalyl chloride"
      },
      "action": "warn",
      "rationale": "Toxic, corrosive gases (CO, CO2, HCl) released; ensure scrubbing and venting."
    },
    {
      "id": "AMIDE-GUARD-ALCOHOL-PRESENT",
      "if": {
        "functional_groups": {
          "alcohols_free": true
        },
        "route": "CDI"
      },
      "action": "avoid_or_penalize",
      "rationale": "CDI acyl imidazoles may O-acylate unprotected alcohols/phenols."
    },
    {
      "id": "AMIDE-GUARD-UREA-REARRANGEMENT",
      "if": {
        "reagent in": [
          "DCC",
          "DIC"
        ],
        "no_additive": true
      },
      "action": "warn_or_substitute",
      "rationale": "O-acylurea → N-acylurea rearrangement gives dead-end byproducts; add Oxyma or switch reagent."
    },
    {
      "id": "AMIDE-GUARD-DIAMINE-OVERACYLATION",
      "if": {
        "amine": {
          "class": "diamine"
        }
      },
      "action": "enforce",
      "params": {
        "slow_addition": true,
        "use_excess_base": false,
        "protect_if_needed": true
      },
      "rationale": "Minimize bis-acylation; consider temporary protection or slow/low-temperature addition."
    }
  ],
  "priors": [
    {
      "feature": "amine_class=aniline",
      "effect": "boost",
      "targets": [
        "AMIDE-HATU-HINDERED",
        "AMIDE-ACID-CHLORIDE",
        "AMIDE-ACYL-FLUORIDE-TFFH"
      ],
      "comment": "Less nucleophilic amines benefit from stronger activation or acyl fluorides."
    },
    {
      "feature": "hindered_substrates=true",
      "effect": "boost",
      "targets": [
        "AMIDE-HATU-HINDERED",
        "AMIDE-T3P-SCALE",
        "AMIDE-HINDEREDxHINDERED"
      ],
      "comment": "Bulky acids/amines often need uronium/phosphonic activation."
