$DTYPE RXN:VAR(1):REFERENCE(1):TITLE
$DATUM A Straightforward Protocol for One-Pot Allylic Aminations/Stille
Couplings
$DTYPE RXN:VAR(1):REFERENCE(1):AUTHOR
$DATUM Bukovec, Christian; Kazmaier, Uli
$DTYPE RXN:VAR(1):REFERENCE(1):CITATION
$DATUM Organic Letters (2009), 11(15), 3518-3521

