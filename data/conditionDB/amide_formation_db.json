  "guardrails": [
    {
      "id": "GD-EXPLOSIVE-BENZOTRIAZOLES",
      "if": {
        "additive_or_reagent in": [
          "HOBt",
          "HOAt",
          "HBTU",
          "HATU",
          "TBTU"
        ]
      },
      "action": "warn_or_substitute",
      "message": "Dry benzotriazole systems can be impact/thermal sensitive; prefer Oxyma/COMU or T3P when feasible.",
      "severity": "high"
    },
    {
      "id": "GD-ACID-CHLORIDE-GAS",
      "if": {
        "activator in": [
          "oxalyl chloride",
          "SOCl2"
        ]
      },
      "action": "warn",
      "message": "CO/CO2/HCl evolved—use traps and ventilation; consider acyl fluorides for cleaner profiles.",
      "severity": "medium"
    },
    {
      "id": "GD-CDI-ALCOHOLS",
      "if": {
        "route": "CDI",
        "functional_groups.alcohols_free": true
      },
      "action": "penalize",
      "message": "CDI acyl imidazoles can O-acylate free alcohols/phenols—use acyl fluoride or EDC/Oxyma instead.",
      "severity": "medium"
    },
    {
      "id": "GD-DCC-NO-ADDITIVE",
      "if": {
        "reagent": "DCC",
        "no_additive": true
      },
      "action": "warn_or_substitute",
      "message": "O→N acylurea rearrangement without Oxyma/HOBt-type additive.",
      "severity": "medium"
    },
    {
      "id": "GD-DIAMINE-OVERACYLATION",
      "if": {
        "amine.class": "diamine"
      },
      "action": "enforce_params",
      "params": {
        "slow_addition": true,
        "temp_max_C": 0,
        "use_excess_base": false
      },
      "message": "Minimize bis-acylation; consider temporary mono-protection."
    },
    {
      "id": "GD-ALPHA-AA-PROTECTION-CHECK",
      "if": {
        "acid.is_alpha_amino_acid": true
      },
      "action": "enforce_params",
      "params": {
        "cap_temperature_C": 25,
        "cap_time_h": 6,
        "require_feature": [
          "acid.internal_amine_free"
        ]
      },
      "message": "For α-amino acids, declare whether the α-NH2 is protected. Favor cold/short activation; consider acyl-fluoride/mixed-anhydride."
    },
    {
      "id": "GD-ALPHA-CHIRAL-EE",
      "if": {
        "acid.class": "alpha-chiral"
      },
      "action": "route_preference",
      "prefer": [
        "AM-ACYL-FLUORIDE-TFFH_BTFFH",
        "AM-MIXED-ANHYDRIDE-IBCF",
        "AM-EDC-OXYMA-GENERAL",
        "AM-T3P-SCALE-EASYWORKUP"
      ],
      "cap_temperature_C": 25,
      "cap_time_h": 6,
      "message": "Limit activation lifetime; sample chiral HPLC periodically."
    }
  ],
