{
  "schema_version": "2.0",
  "label_schema_version": "4.0",
  "default_style": "unicode",
  "clause_order": ["broken", "order_changed", "formed", "hydrogen_change"],
  "element_precedence": ["C", "N", "O", "S", "P", "B", "Si", "H", "F", "Cl", "Br", "I"],
  "fragment_context_symbols": ["HeteroAr", "Ar", "R"],
  "styles": {
    "unicode": {
      "single": "–",
      "double": "=",
      "triple": "≡",
      "aromatic": ":",
      "arrow": "→",
      "times": "×",
      "separator": "; ",
      "event_separator": " + ",
      "event_detail_separator": " | ",
      "fragment_index_format": "superscript",
      "formula_count_format": "subscript"
    },
    "ascii": {
      "single": "-",
      "double": "=",
      "triple": "#",
      "aromatic": ":",
      "arrow": "->",
      "times": "x",
      "separator": "; ",
      "event_separator": " + ",
      "event_detail_separator": " | ",
      "fragment_index_format": "plain",
      "formula_count_format": "plain"
    },
    "hte_legacy": {
      "single": "-",
      "double": "=",
      "triple": "#",
      "aromatic": ":",
      "arrow": "->",
      "times": "x",
      "separator": "; ",
      "event_separator": " + ",
      "event_detail_separator": " | ",
      "fragment_index_format": "plain",
      "formula_count_format": "plain"
    }
  },
  "templates": {
    "formed": "{left}{bond}{right} bond formation",
    "broken": "{left}{bond}{right} bond cleavage",
    "order_changed": "{left}{old_bond}{right} {arrow} {left}{new_bond}{right}",
    "hydrogen_gain": "H gain at {center}",
    "hydrogen_loss": "{center}{bond}H loss",
    "counted_clause": "{count} {times} {clause}",
    "mapped_atom": "{element}(map {map_number})",
    "conflict": "Conflicting evidence: {clauses}",
    "conflict_detail": "{label}; conflicting evidence; details: {clauses}",
    "exact_detail": "{label}; edits: {clauses}",
    "contextual_detail": "{label}; transformation: {transformation}; edits: {clauses}",
    "observed_detail": "{label}; edits: {clauses}",
    "event_detail": "Event {number}: {label}; edits: {clauses}",
    "multi_event_detail": "{label}; events: {events}",
    "intramolecular_context": "intramolecular",
    "intramolecular_ring_context": "intramolecular ({ring_size}-membered ring)",
    "ring_formation_concise": "{fragments} {arrow} {aromatic}{ring_size}-membered {formula} ring",
    "ring_formation_detail": "{component_count}-component ring formation: {concise}; key connectivity: {formed_bonds}; ring count +1{electronic}; evidence: {evidence} (confidence {confidence}); raw edits: {raw_edits}",
    "ring_aromatization": "; electronic reorganization: reactant pi system {arrow} aromatic ring",
    "provisional_core": "Provisional core ({evidence}): {core}",
    "core_projection": "core projection: {equation}",
    "core_bond_changes": "bond changes: {changes}",
    "core_atom_state_changes": "atom-state changes: {changes}",
    "core_retained_context": "retained context: {contexts}",
    "core_departing_context": "departing context: {contexts}",
    "core_appearing_context": "appearing context: {contexts}",
    "core_evidence": "core evidence: {evidence}",
    "core_quality": "core quality: {quality}",
    "literal_edit_audit": "literal edits: {clauses}",
    "pattern_overlay": "transformation pattern: {label}"
  }
}
