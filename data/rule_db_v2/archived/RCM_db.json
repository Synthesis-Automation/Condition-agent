{
  "schema_version": "2.0",
  "source_type": "rule",
  "metadata": {
    "id": "rcm_v2",
    "name": "Ring-Closing Metathesis (RCM)",
    "version": "v2.0",
    "created_date": "2025-11-08",
    "status": "active",
    "tags": []
  },
  "reaction": {
    "family": "ring_closing_metathesis",
    "reference_reactions": [
      "C=CCCC=C>>C1=CCCC1",
      "C=CCCCCC=C>>C1=CCCCC1",
      "C=CCC(=O)CC=C>>C1=CCC(=O)C1",
      "C=CCc1ccc(CC=C)cc1>>C=CCc1ccc(CC1)cc1",
      "C=C(C)CCC=C>>CC1=CCCC1",
      "C=CCCCCCCCC=C>>C1=CCCCCCCC1"
    ],
    "scope": {
      "scope_type": "broad",
      "compatible_functional_groups": [],
      "incompatible_functional_groups": []
    },
    "notes": "Draft RCM rule derived to mirror the structure and intent of the C–N coupling rule file. Apply only when intramolecular alkene–alkene closure is plausible. Choose the first matching base_rule (top→down); if none match, use default_rule. Then apply any matching modifiers (tokens or plain‑text heuristics). Notes: Ru–NHC Hoveyda/Grubbs catalysts are broadly tolerant; remove ethylene to drive equilibrium; high dilution/slow addition for medium/large rings; benzoquinone (BQ) suppresses Ru–hydride isomerization; protect or attenuate strongly coordinating amines/thiols. Quench with ethyl vinyl ether at completion to deactivate Ru."
  },
  "applies_if": {
    "any": [
      "diene_present",
      "alkene_present",
      "terminal_alkene_present",
      "internal_alkene_present"
    ]
  },
  "default_rule": {
    "id": "DEF_RCM_general",
    "description": "General RCM using HG‑II at moderate dilution; remove ethylene.",
    "conditions": {
      "ru_catalyst": "Hoveyda–Grubbs II (HG‑II)",
      "catalyst_loading_molpct": "5 (2–10)",
      "solvent": "CH2Cl2 or toluene (or DCE / 2‑MeTHF)",
      "substrate_concentration_mM": "10–50",
      "temperature_C": "25–60",
      "time_h": "0.5–6",
      "ethylene_removal": "slow N2 sweep or vented sealed tube",
      "atmosphere": "N2 or Ar; dry glassware"
    }
  },
  "base_rules": [
    {
      "name": "Small/medium rings (5–7‑member) from dienes",
      "id": "BR_RCM_5_7",
      "description": "Typical intramolecular diene closures to 5–7 rings.",
      "reactant_features": {
        "all": [
          "diene_present"
        ],
        "any": [
          "predicted_ring_size_5_to_7"
        ]
      },
      "conditions": {
        "ru_catalyst": "Hoveyda–Grubbs II (HG‑II) or Grubbs II (G‑II)",
        "catalyst_loading_molpct": "2–5",
        "solvent": "CH2Cl2 (preferred) or toluene",
        "substrate_concentration_mM": "20–50",
        "temperature_C": "25–40",
        "time_h": "0.5–4",
        "ethylene_removal": "slow N2 sweep"
      }
    },
    {
      "name": "Medium rings (8–12‑member)",
      "id": "BR_RCM_8_12",
      "description": "Use faster‑initiating catalysts; dilution and slow addition reduce oligomerization.",
      "reactant_features": {
        "all": [
          "diene_present"
        ],
        "any": [
          "predicted_ring_size_8_to_12"
        ]
      },
      "conditions": {
        "ru_catalyst": "Nitro‑Grela / Grela (fast‑initiating Hoveyda) or HG‑II",
        "catalyst_loading_molpct": "5–10",
        "solvent": "toluene or DCE (alt: CH2Cl2, 2‑MeTHF)",
        "substrate_concentration_mM": "5–20",
        "temperature_C": "40–80",
        "time_h": "2–12",
        "addition_mode": "slow addition via syringe pump (optional)",
        "ethylene_removal": "continuous N2 sweep"
      }
    },
    {
      "name": "Macrocycles (≥13‑member)",
      "id": "BR_RCM_macrocycle_13plus",
      "description": "Very high dilution and slow addition; consider higher loadings and longer times.",
      "reactant_features": {
        "all": [
          "diene_present"
        ],
        "any": [
          "predicted_ring_size_13_or_more",
          "macrocycle_target"
        ]
      },
      "conditions": {
        "ru_catalyst": "Hoveyda–Grubbs II (HG‑II) or Grela",
        "catalyst_loading_molpct": "5–15",
        "solvent": "toluene or CH2Cl2",
        "substrate_concentration_mM": "0.5–2",
        "temperature_C": "40–80",
        "time_h": "6–24",
        "addition_mode": "slow addition (syringe pump)",
        "ethylene_removal": "N2 sweep or intermittent vacuum/vent"
      }
    },
    {
      "name": "Hindered targets (tri/tetrasubstituted internal alkene)",
      "id": "BR_RCM_hindered_internal",
      "description": "Use very fast‑initiating Ru catalysts; higher temperature and loadings are often needed.",
      "reactant_features": {
        "all": [
          "diene_present"
        ],
        "any": [
          "tetrasubstituted_alkene_target",
          "high_steric_crowding_around_alkenes"
        ]
      },
      "conditions": {
        "ru_catalyst": "Stewart–Grubbs / Nitro‑Grela / Umicore M2 (fast‑initiating)",
        "catalyst_loading_molpct": "7–15",
        "solvent": "toluene (alt: DCE)",
        "substrate_concentration_mM": "5–20",
        "temperature_C": "70–110",
        "time_h": "4–16",
        "additive": "1,4‑benzoquinone (2–5 mol%) to suppress isomerization",
        "ethylene_removal": "continuous N2 sweep"
      }
    },
    {
      "name": "Enyne RCM (enyne cycloisomerization)",
      "id": "BR_RCM_enyne",
      "description": "Intramolecular alkene–alkyne closure to 1,3‑diene products.",
      "reactant_features": {
        "all": [
          "enyne_present",
          "intramolecular_closure_possible"
        ]
      },
      "conditions": {
        "ru_catalyst": "Hoveyda–Grubbs II (HG‑II) or Grubbs II (G‑II)",
        "catalyst_loading_molpct": "2–8",
        "solvent": "toluene or CH2Cl2",
        "substrate_concentration_mM": "10–30",
        "temperature_C": "25–80",
        "time_h": "1–8",
        "ethylene_removal": "vent or N2 sweep"
      }
    },
    {
      "name": "Lewis‑basic / heteroatom‑rich substrates",
      "id": "BR_RCM_heteroatom_rich",
      "description": "Mitigate Ru–hydride isomerization and coordination by heteroatoms (amines, pyridines, sulfides).",
      "reactant_features": {
        "any": [
          "free_amine_present",
          "pyridine_present",
          "imidazole_present",
          "thiol_or_sulfide_present",
          "allylic_alcohol_present"
        ]
      },
      "conditions": {
        "ru_catalyst": "Hoveyda–Grubbs II (HG‑II)",
        "catalyst_loading_molpct": "5–10",
        "solvent": "toluene or DCE",
        "substrate_concentration_mM": "10–30",
        "temperature_C": "40–80",
        "time_h": "2–12",
        "additive": "1,4‑benzoquinone (2–5 mol%)",
        "note": "Protect free amines (e.g., Boc/CBz) or attenuate coordination; avoid excess base"
      }
    }
  ],
  "modifiers": [
    {
      "id": "MOD_RCM_remove_ethylene",
      "when": [
        "always"
      ],
      "suggest": "Remove ethylene (N2 sweep or periodic venting) to drive equilibrium toward cyclization."
    },
    {
      "id": "MOD_RCM_high_dilution",
      "when": [
        "macrocycle_target",
        "oligomerization_symptom"
      ],
      "suggest": "Use ≤2 mM substrate and slow addition (syringe pump) to favor intramolecular closure."
    },
    {
      "id": "MOD_RCM_isomerization_control",
      "when": [
        "double_bond_isomerization_risk",
        "allylic_alcohol_present",
        "aldehyde_present"
      ],
      "suggest": "Add 1,4‑benzoquinone 2–5 mol% (or a trace acid such as AcOH 0.1–1 equiv) to suppress Ru–hydride isomerization."
    },
    {
      "id": "MOD_RCM_fast_initiation",
      "when": [
        "slow_initiation_symptom",
        "tetrasubstituted_alkene_target"
      ],
      "suggest": "Switch to fast‑initiating catalysts (Nitro‑Grela, Stewart–Grubbs, Umicore M2) and raise temperature."
    },
    {
      "id": "MOD_RCM_free_amine_poisoning",
      "when": [
        "free_amine_present"
      ],
      "suggest": "Protect as carbamate (Boc/CBz) or reduce basicity; avoid strong amine bases during RCM."
    },
    {
      "id": "MOD_RCM_sulfur_poisoning",
      "when": [
        "thiol_or_sulfide_present"
      ],
      "suggest": "Mask/oxidize sulfur or use scavengers (e.g., Ag2O) prior to RCM; expect reduced activity."
    },
    {
      "id": "MOD_RCM_solubility_switch",
      "when": [
        "low_solubility_symptom"
      ],
      "suggest": "Switch solvent (toluene ↔ CH2Cl2 ↔ DCE ↔ 2‑MeTHF) or add co‑solvent to reach the target dilution."
    },
    {
      "id": "MOD_RCM_quench",
      "when": [
        "always"
      ],
      "suggest": "Quench residual Ru with ethyl vinyl ether (5–10 equiv) at completion, then concentrate under reduced pressure."
    },
    {
      "id": "MOD_RCM_Z_selective_option",
      "when": [
        "Z_selective_desired"
      ],
      "suggest": "Use Z‑selective Ru–dithiolate Hoveyda‑type catalysts; operate at lower temperature and higher dilution."
    },
    {
      "id": "MOD_RCM_tolerance_water_trace",
      "when": [
        "trace_water_present"
      ],
      "suggest": "Trace moisture is usually tolerated with Ru–NHC catalysts; dry glassware remains recommended."
    }
  ]
}