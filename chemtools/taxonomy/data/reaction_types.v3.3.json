  "design": {
    "principle": "Avoid calculable_features. Reaction typing is defined by explicit reactant motif lists (from organic_compounds).",
    "how_to_edit": [
      "Define reaction_types[*].reactants.<slot> as a list of compound IDs or an object with motif_sets/include/exclude.",
      "Use reactants.nucleophiles as the second-component list for cross-couplings (e.g., organoboron, terminal alkyne, alkene) and for classical nucleophiles (amines, alcohols, thiols).",
      "Prefer motif_sets for shared lists; use include/exclude for per-reaction tweaks."
    ],
    "slots": [
      "electrophiles",
      "nucleophiles",
      "acids",
      "activators"
    ],
