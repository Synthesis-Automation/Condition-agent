    {
      "rule_id": "pd_sp2_cn.free_amine.hindered_ar_cl.v1",
      "status": "draft",
      "rule_kind": "structural_override",
      "scope": {
        "transformation_classes_any": ["sp2_c_n_substitution"],
        "event_scopes_any": ["single_event"],
        "evidence_qualities_any": ["exact_product_reconstruction"],
        "reaction_scopes_any": ["intermolecular"]
      },
      "match": {
        "partner_constraints": [
          {
            "role": "electrophile",
            "site_type": "leaving_group",
            "anchor_contexts_any": ["Ar", "HeteroAr"],
            "handle_tokens_any": ["Cl"],
            "context_kinds_any": ["aromatic"],
            "ortho_occupancy_min": 2,
            "ortho_burden_classes_any": ["high"]
          },
          {
            "role": "nucleophile",
            "site_type": "pronucleophile_XH",
            "center_tokens_any": ["N"],
            "derived_families_any": ["primary_amine", "secondary_amine"],
            "h_count_min": 1,
            "availability_any": ["free"]
          }
        ]
      },
      "selection": {
        "group": "pd_sp2_cn.condition_regime",
        "tier": "specific",
        "priority": 400
      },
      "recommendations": [
        {"recipe_template_id": "pd_sp2_cn.free_amine.hindered_ar_cl.v1"}
      ],
      "rationale": "A highly ortho-hindered aryl chloride requires a deliberately forcing palladium starter protocol rather than the free-amine default.",
      "cautions": [
        "Combined aryl-chloride and severe steric demand is a screening starting point, not a validated universal procedure."
      ],
      "provenance": {
        "basis": "legacy_buchwald_hartwig_cn_rulebook_plus_expert_review",
        "source_rule_ids": ["BH_CN_01", "BH_CN_02", "BH_CN_05"],
        "review_required": true
      }
