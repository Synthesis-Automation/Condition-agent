{
  "schema_version": "1.0",
  "benchmark_id": "molecular_features.v1",
  "description": "Curated mechanism-neutral molecular reactivity benchmark for Phase 1.",
  "thresholds": {
    "critical_case_pass_rate": 1.0,
    "functional_group_precision": 0.95,
    "functional_group_recall": 0.95,
    "reactive_site_precision": 0.95,
    "reactive_site_recall": 0.95,
    "reactive_atom_accuracy": 0.95,
    "environment_check_accuracy": 0.9,
    "determinism_rate": 1.0,
    "equivalent_smiles_invariance_rate": 1.0,
    "taxonomy_error_count": 0
  },
  "partitions": {
    "development": [
      "primary_methylamine",
      "primary_aniline",
      "benzyl_chloride",
      "aryl_boronic_acid",
      "acetic_acid",
      "phenol",
      "terminal_alkene"
    ],
    "validation": [
      "secondary_dimethylamine",
      "heteroaryl_chloride",
      "aryl_bpin",
      "acetyl_chloride",
      "acetaldehyde",
      "ethyl_thiol",
      "aryl_epoxide",
      "negative_ethane"
    ],
    "test": [
      "primary_tert_butylamine",
      "aryl_bromide_with_nitrile",
      "acetone",
      "secondary_sulfonamide",
      "terminal_alkyne",
      "aminopyridine",
      "hindered_electron_poor_aryl_bromide",
      "invalid_smiles"
    ]
