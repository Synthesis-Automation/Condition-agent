{
  "name": "Sonogashira Coupling (Pd–Cu / Cu‑free)",
  "reaction_type": "Sonogashira C(sp2)–C(sp) Coupling",
  "version": "2025-11-08",
  "evaluation": "Scope notes & usage:\n• Couples aryl/vinyl (pseudo)halides with terminal alkynes. Requires a terminal C≡C–H (or TMS‑alkyne + mild deprotection).\n• Oxygen promotes Glaser homocoupling (diyne). Run under N2/Ar; degas thoroughly. Copper‑free tracks mitigate Glaser.\n• Bases: organic amines (Et3N, DIPEA) or inorganic carbonates (K2CO3, Cs2CO3). Amine can be solvent + base.\n• Electrophile reactivity: Ar–I ≈ vinyl–OTf > Ar–Br > Ar–Cl. Aryl chlorides often need stronger ligation (XPhos/SPhos, PtBu3, NHC) and higher T.\n• Typical charges (start points): 0.5–2 mol% Pd, 2–5 mol% CuI (when used), 1.2–1.5 equiv alkyne, 2–3 equiv base, 5–10 vol solvent per g.\nHow to use:\n1) Ensure 'applies_if' tokens match (terminal_alkyne_present AND a suitable electrophile token). 2) Try base_rules (top→down). 3) If none match, use default_rule.\n4) After choosing a rule, scan modifiers and apply all that match (tokens OR plain‑text heuristics).",
  "applies_if": {
    "all": [
      "terminal_alkyne_present"
    ],
    "any": [
      "aryl_halide_present",
      "vinyl_halide_present",
      "aryl_triflate_present",
      "vinyl_triflate_present"
    ]
  },
  "default_rule": {
    "id": "DEF_sonogashira_general",
    "description": "General Sonogashira (Et3N/DIPEA; CuI‑assisted; degassed).",
    "conditions": {
      "pd_precatalyst": "PdCl2(PPh3)2 or Pd(dppf)Cl2·DCM (ligand‑containing precatalyst preferred)",
      "pd_loading_molpct": "0.5–2.0 (1.0 default)",
      "ligand": "Built‑in (PPh3 or dppf). If in‑situ Pd source, add PPh3 or XPhos (2–4 mol%)",
      "cu_cocatalyst": "CuI 2–5 mol% (omit if copper‑free track chosen)",
      "base": "Et3N or DIPEA (2.0–3.0 equiv)",
      "solvent": "THF, toluene, or DMF (or use neat Et3N/DIPEA)",
      "solvent_volume_vol_per_g": "5–10",
      "alkyne_equiv": "1.2–1.5",
      "temperature_C": "40–80",
      "time_h": "1–8",
      "atmosphere": "N2 or Ar; thoroughly degassed"
    }
  },
  "base_rules": [
    {
      "name": "Aryl iodides/bromides (standard reactivity)",
      "id": "BR_ArI_ArBr_standard",
      "description": "Fast track with mild bases; CuI typically helpful but optional if Glaser is problematic.",
      "reactant_features": {
        "any": [
          "sp2_bromide_present",
          "sp2_iodide_present"
        ]
      },
      "conditions": {
        "pd_precatalyst": "PdCl2(PPh3)2 or Pd(dppf)Cl2·DCM",
        "pd_loading_molpct": "0.5–1.5",
        "cu_cocatalyst": "CuI 2–5 mol% (optional)",
        "base": "Et3N or DIPEA (2.0–3.0 equiv)",
        "solvent": "THF, toluene, or DMF",
        "temperature_C": "40–70"
      }
    },
    {
      "name": "Aryl chlorides or deactivated/ortho‑blocked aryls",
      "id": "BR_ArCl_hard",
      "description": "Hard electrophiles; use stronger ligation and higher temperature. Copper‑free favored to avoid side reactions.",
      "reactant_features": {
        "any": [
          "sp2_chloride_present",
          "ortho_substitution_present",
          "strongly_electron_withdrawing_ring_present"
        ]
      },
      "conditions": {
        "pd_precatalyst": "XPhos–Pd G3 or SPhos–Pd G3; alt: Pd(dba)2 + XPhos/SPhos or Pd–PtBu3",
        "pd_loading_molpct": "1.0–3.0",
        "cu_cocatalyst": "omit (copper‑free) or CuI ≤2 mol% if needed",
        "base": "DIPEA (3.0 equiv) or Cs2CO3 (2.0–3.0 equiv)",
        "solvent": "1,4‑dioxane, toluene, or DMF",
        "temperature_C": "80–110"
      }
    },
    {
      "name": "Vinyl halides/triflates",
      "id": "BR_vinyl_electrophiles",
      "description": "Often clean at lower temperatures. Watch for isomerization under strongly basic or high‑T conditions.",
      "reactant_features": {
        "any": [
          "vinyl_halide_present",
          "vinyl_triflate_present"
        ]
      },
      "conditions": {
        "pd_precatalyst": "PdCl2(PPh3)2 or Pd(dppf)Cl2·DCM",
        "pd_loading_molpct": "0.5–1.5",
        "cu_cocatalyst": "CuI 2–4 mol% (optional)",
        "base": "Et3N or K2CO3 (2.0–3.0 equiv)",
        "solvent": "THF or DMF",
        "temperature_C": "25–60"
      }
    },
    {
      "name": "Heteroaryl halides (pyridyl, indolyl, etc.)",
      "id": "BR_heteroaryl",
      "description": "Coordinate strongly and can poison catalysts; favor bulkier ligation and consider copper‑free to avoid Glaser.",
      "reactant_features": {
        "any": [
          "heteroaryl_present",
          "pyridine_nitrogen_present"
        ]
      },
      "conditions": {
        "pd_precatalyst": "SPhos–Pd G3 or Pd–NHC (IPr/PEPPSI‑IPr)",
        "pd_loading_molpct": "1.0–2.0",
        "cu_cocatalyst": "omit (copper‑free) or CuI ≤2 mol%",
        "base": "DIPEA or Cs2CO3 (2.0–3.0 equiv)",
        "solvent": "DMF or 1,4‑dioxane",
        "temperature_C": "50–90"
      }
    },
    {
      "name": "Copper‑free window (Glaser‑sensitive or S/azide‑bearing)",
      "id": "BR_copper_free",
      "description": "Use when Glaser homocoupling or Cu‑promoted side reactions are a concern (e.g., thiols, azides, delicate alkynes).",
      "reactant_features": {
        "any": [
          "glaser_homocoupling_risk",
          "thiol_poison_risk",
          "azide_present",
          "sensitive_alkyne_present"
        ]
      },
      "conditions": {
        "pd_precatalyst": "XPhos–Pd G3, SPhos–Pd G3, or Pd–NHC (IPr/PEPPSI‑IPr)",
        "pd_loading_molpct": "1.0–2.0",
        "cu_cocatalyst": "omit",
        "base": "DIPEA or K2CO3 (2.0–3.0 equiv)",
        "solvent": "DMF, MeCN, or 1,4‑dioxane",
        "temperature_C": "40–90"
      }
    }
  ],
  "modifiers": [
    {
      "id": "MOD_exclude_oxygen",
      "when": [
        "always"
      ],
      "suggest": "Exclude O2 rigorously (freeze‑pump‑thaw or sparge). Oxygen promotes Glaser homocoupling."
    },
    {
      "id": "MOD_prefer_copper_free_if_glaser",
      "when": [
        "symptom:diyne formation observed",
        "glaser_homocoupling_risk"
      ],
      "suggest": "Switch to copper‑free conditions (route:Cu‑free) and consider bulkier ligation (XPhos/SPhos or NHC)."
    },
    {
      "id": "MOD_aryl_chloride_upgrade",
      "when": [
        "sp2_chloride_present"
      ],
      "suggest": "Upgrade to XPhos/SPhos or PtBu3 systems at ≥90–100 °C; consider Pd–NHC."
    },
    {
      "id": "MOD_water_tolerance",
      "when": [
        "any"
      ],
      "suggest": "Small amounts of water are generally tolerated but avoid wet CuI (variable activity). Keep CuI dry if used."
    },
    {
      "id": "MOD_amine_as_solvent",
      "when": [
        "polarity_low"
      ],
      "suggest": "Use Et3N or DIPEA as both solvent and base to enhance rates in apolar systems."
    },
    {
      "id": "MOD_carbonate_track",
      "when": [
        "base_sensitive"
      ],
      "suggest": "Use inorganic carbonate base (K2CO3/Cs2CO3) in polar aprotic solvent at 50–80 °C."
    },
    {
      "id": "MOD_TMSA_surrogate",
      "when": [
        "route:use_acetylene_gas"
      ],
      "suggest": "Use TMS‑acetylene as a safer surrogate; couple then desilylate under mild base/MeOH."
    },
    {
      "id": "MOD_cu_trace_effect",
      "when": [
        "symptom:slow rate in Cu‑free variant"
      ],
      "suggest": "Seed with 0.5–1 mol% CuI or add catalytic KI to accelerate transmetalation."
    },
    {
      "id": "MOD_additive_halide_acceleration",
      "when": [
        "sp2_bromide_present",
        "sp2_chloride_present"
      ],
      "suggest": "Add TBAB (0.5–1.0 equiv) to enhance rate/solubility with less‑reactive aryl halides."
    },
    {
      "id": "MOD_thiol_or_amine_poisons",
      "when": [
        "thiol_poison_risk",
        "pyridine_poison_risk"
      ],
      "suggest": "Increase Pd loading by +0.5–1.0 mol% and/or switch to stronger donor ligation (NHC, bulky phosphines)."
    },
    {
      "id": "MOD_vinyl_isomerization_guard",
      "when": [
        "vinyl_halide_present"
      ],
      "suggest": "Lower temperature (≤60 °C), use milder base (Et3N), and minimize reaction time to avoid E/Z isomerization."
    }
  ],
