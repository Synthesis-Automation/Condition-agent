      "structural_band_penalty": 1
    },
    "medium": {
      "disposition": "warn",
      "structural_band_penalty": 0
    },
    "low": {
      "disposition": "warn",
      "structural_band_penalty": 0
    }
  },
  "aggregation": {
    "band_penalty": "maximum",
    "disposition_order": ["pass", "warn", "demote", "reject"]
  }
}
