      "id": "suzuki_miyaura",
      "name": "Suzuki\u2013Miyaura coupling",
      "category": "c_c_coupling_reactions",
      "aliases": [
        "Suzuki",
        "Suzuki coupling"
      ],
      "description": "Pd-catalyzed cross-coupling of aryl/vinyl halides with organoboron compounds",
      "reference_reactions": [
        "Brc1ccccc1.OB(O)c1ccccc1>>c1ccc(-c2ccccc2)cc1",
        "Clc1ccc(C#N)cc1.c1ccc(B(O)O)cc1>>N#Cc1ccc(-c2ccccc2)cc1",
        "C/C=C/Br.C=CB(O)O>>C/C=C/C=C",
        "BrC1(c2ccccc2)CC1.c1ccc(B(O)O)cc1>>c1ccc(C2(c3ccccc3)CC2)cc1",
        "Brc1ccncc1.c1csc(B(O)O)c1>>c1cc(-c2cccs2)ccn1",
        "Brc1ccc(OC)cc1.[K+].[B-](F)(F)c2ccccc2>>COc1ccc(-c2ccccc2)cc1"
      ],
      "catalysts": [
        "Pd"
      ],
      "conditions": "Base, ligand (phosphine), solvent",
      "metadata": {
        "rule_db_v2": "Suzuki_db"
      },
      "reactants": {
        "electrophiles": {
          "motif_sets": [
            "sp2_electrophiles_default"
          ]
        },
        "nucleophiles": {
          "motif_sets": [
            "organoboron_default"
          ]
        }
      },
      "edit_hint": "To exclude a class (e.g., Ar-OMs), add it to reactants.electrophiles.exclude or remove it from motif_sets.",
      "notes": "Motif typing: electrophile \u2208 sp2_electrophiles_default AND partner \u2208 organoboron_default."
    },
    {
