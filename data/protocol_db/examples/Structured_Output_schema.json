[
  {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Structured_Output_schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source",
      "reaction",
      "reaction_setup",
      "workup_and_purification",
      "original_procedure"
    ],
    "properties": {
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "journal",
          "volume",
          "pages",
          "year",
          "doi",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "journal": {
            "type": "string"
          },
          "volume": {
            "type": [
              "integer",
              "string"
            ]
          },
          "pages": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "doi": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "reaction": {
        "type": "object",
        "description": "Must match the exact field set (no additions/deletions).",
        "additionalProperties": false,
        "required": [
          "reaction_smiles",
          "family",
          "notes",
          "tags"
        ],
        "properties": {
          "reaction_smiles": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "tags": {
            "type": "string"
          }
        }
      },
      "reaction_setup": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chemicals",
            "conditions"
          ],
          "properties": {
            "chemicals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "abbreviation",
                  "cas",
                  "smiles",
                  "amount",
                  "role"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "abbreviation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cas": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^\\d{2,7}-\\d{2}-\\d$"
                  },
                  "smiles": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "amount": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "weight_g",
                      "mmol",
                      "volume_ml",
                      "equivalents"
                    ],
                    "properties": {
                      "weight_g": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "mmol": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "volume_ml": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "equivalents": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "starting_material",
                      "electrophile",
                      "nucleophile",
                      "base",
                      "acid",
                      "additive",
                      "ligand",
                      "metal_precursor",
                      "preformed_catalyst",
                      "co_catalyst",
                      "activator",
                      "photocatalyst",
                      "solvent",
                      "internal_standard",
                      "oxidant",
                      "reductant",
                      "quenchant",
                      "drying_agent",
                      "stationary_phase"
                    ]
                  }
                }
              }
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "temperature_C",
                  "time_h",
                  "atmosphere"
                ],
                "properties": {
                  "temperature_C": {
                    "type": "number"
                  },
                  "time_h": {
                    "type": "number"
                  },
                  "atmosphere": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "workup_and_purification": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quench",
            "workup",
            "purification",
            "notes"
          ],
          "properties": {
            "quench": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reagent",
                  "details"
                ],
                "properties": {
                  "reagent": {
                    "type": "string"
                  },
                  "details": {
                    "type": "string"
                  }
                }
              }
            },
            "workup": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "step",
                  "details"
                ],
                "properties": {
                  "step": {
                    "type": "string"
                  },
                  "details": {
                    "type": "string"
                  }
                }
              }
            },
            "purification": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "stationary_phase",
                  "eluent",
                  "fractions"
                ],
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "stationary_phase": {
                    "type": "string"
                  },
                  "eluent": {
                    "type": "string"
                  },
                  "fractions": {
                    "type": "string"
                  }
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "original_procedure": {
        "type": "string",
        "description": "Verbatim text of the source procedure (try to make it complete)."
      }
    }
  }
]