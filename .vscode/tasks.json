{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start scientific chat",
            "type": "process",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "-m",
                "app.web_api",
                "--scientific-chat",
                "--port",
                "8011",
                "--agent-profile",
                "research"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            }
        }
    ]
}
