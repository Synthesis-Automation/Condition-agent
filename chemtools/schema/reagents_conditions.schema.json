{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reagents_conditions.schema.json",
  "title": "Reagents+Conditions (mini)",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string"
    },
    "reaction_type": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "selectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/selector"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "entries"
      ]
    },
    {
      "required": [
        "selectors"
      ]
    }
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "reagents": {
          "$ref": "#/$defs/reagents"
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        }
      },
      "required": [
        "reagents",
        "conditions"
      ]
    },
    "selector": {
      "type": "object",
      "properties": {
        "then": {
          "$ref": "#/$defs/thenBlock"
        }
      },
      "required": [
        "then"
      ]
    },
    "thenBlock": {
      "type": "object",
      "properties": {
        "reagents": {
          "$ref": "#/$defs/reagents"
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/thenBlock"
          }
        }
      },
      "required": [
        "reagents",
        "conditions"
      ]
    },
    "reagents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reagent"
      }
    },
    "reagent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "metal_source",
            "ligand",
            "base",
            "solvent",
            "additive"
          ]
        },
        "amount": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "role",
        "amount"
      ]
    },
    "conditions": {
      "type": "object",
      "properties": {
        "temperature_C": {
          "$ref": "#/$defs/range2"
        },
        "time_h": {
          "$ref": "#/$defs/range2"
        }
      },
      "required": []
    },
    "range2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}